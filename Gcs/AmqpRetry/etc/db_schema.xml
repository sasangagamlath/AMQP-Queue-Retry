<?xml version="1.0"?>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="amqp_retry_queue_config" resource="default" engine="innodb" comment="AMQP Queue Retry Configurations">
        <column xsi:type="int" name="config_id" unsigned="true" nullable="false" identity="true" comment="Surrogate key"/>
        <column xsi:type="varchar" name="queue_name" length="255" nullable="false" comment="The AMQP queue name this config applies to"/>
        <column xsi:type="varchar" name="exchange_name" length="255" nullable="false" comment="Exchange to use when publishing retry messages"/>
        <column xsi:type="smallint" name="is_enabled" unsigned="true" nullable="false" default="1" comment="Whether retry is active for this queue"/>
        <column xsi:type="text" name="initial_intervals" nullable="true" comment="JSON array of delay seconds for initial retry attempts"/>
        <column xsi:type="text" name="dlq_intervals" nullable="true" comment="JSON array of delay seconds for DLQ-phase retries"/>
        <column xsi:type="timestamp" name="topology_applied_at" nullable="true" comment="Timestamp of last successful apply-topology run"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Record creation time"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Record last-modified time"/>
        <constraint xsi:type="unique"
                    referenceId="AMQP_RETRY_QUEUE_CONFIG_QUEUE_NAME_UNIQUE">
            <column name="queue_name"/>
        </constraint>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="config_id"/>
        </constraint>
    </table>
</schema>
